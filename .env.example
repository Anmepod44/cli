# CLI Command Assistant - Environment Variables Template
# Copy this file to .env and add your actual values

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Override default configuration
# CLI_ASSISTANT_CONFIG_PATH=~/.cli-assistant/config.yaml
# CLI_ASSISTANT_HISTORY_PATH=~/.cli-assistant/history.json
# CLI_ASSISTANT_LOG_PATH=~/.cli-assistant/errors.log
